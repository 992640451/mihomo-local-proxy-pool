{
  "name": "proxy-port-manager",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "init": "node scripts/init.mjs",
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node server/index.mjs",
    "start": "node server/index.mjs",
    "start:bridge": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-mihomo-bridge.ps1",
    "build": "vite build",
    "docker:update": "node scripts/docker-update.mjs",
    "docker:watch": "docker compose watch proxy-port-manager",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "express": "5.2.1",
    "undici": "^8.10.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2"
  }
}
