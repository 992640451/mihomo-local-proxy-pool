{
  "name": "proxy-port-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node server/index.mjs",
    "start": "node server/index.mjs",
    "start:bridge": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-mihomo-bridge.ps1",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "express": "latest",
    "undici": "^8.10.0",
    "yaml": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  }
}
