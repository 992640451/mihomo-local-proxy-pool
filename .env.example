# 新安装默认使用内置订阅存储，不依赖 Clash Verge。
SUBSCRIPTION_MODE=native
SUBSCRIPTION_USER_AGENT=mihomo/1.19.28
# Fake-IP DNS compatibility. Comma-separate multiple HTTPS JSON DoH endpoints.
# SUBSCRIPTION_DOH_URLS=https://cloudflare-dns.com/dns-query,https://dns.google/resolve
# SUBSCRIPTION_DOH_TIMEOUT_MS=5000
# 同时作为内置 Mihomo 控制器密钥，至少使用 32 位随机字符串。
MIHOMO_CONTROLLER_SECRET=replace-with-a-long-random-secret
AUTH_USERNAME=admin
AUTH_PASSWORD_SALT=replace-with-random-salt
AUTH_PASSWORD_SCRYPT=replace-with-scrypt-hash
AUTH_COOKIE_SECURE=false
AUTH_SESSION_IDLE_SECONDS=7200
AUTH_SESSION_MAX_SECONDS=28800
AUTH_SESSION_TOUCH_SECONDS=300
AUTH_REMEMBER_IDLE_SECONDS=2592000
AUTH_REMEMBER_MAX_SECONDS=2592000
AUTH_SESSION_VERSION=1

# 服务端操作记录默认保留 30 天，最多 10000 条。
AUDIT_RETENTION_DAYS=30
AUDIT_MAX_EVENTS=10000
# API 令牌默认与订阅/会话数据库放在同一持久目录；必须配置管理认证后才能创建。
# API_TOKEN_DB=/data/api-tokens.sqlite
# CLI 使用 PPM_API_URL / PPM_API_TOKEN_FILE / PPM_BACKUP_PASSWORD_FILE；不要把密钥提交到仓库。
# 可观测性设置在管理页面保存；后台检测默认关闭，历史默认保留 7 天 / 20000 条。
# OBSERVABILITY_DB=/data/observability.sqlite
# OBSERVABILITY_TEST_URL=https://www.gstatic.com/generate_204
# EGRESS_LOOKUP_URL=https://ipwho.is/
# 反向代理使用不同来源时，显式列出允许的 Origin（逗号分隔）；本机同源访问无需设置。
# APP_ALLOWED_ORIGINS=https://proxy.example.com

# 仅在使用 compose.legacy.yaml 迁移 Clash Verge 订阅时取消注释并填写。
# CATALOG_SOURCE=C:/Users/USERNAME/AppData/Roaming/io.github.clash-verge-rev.clash-verge-rev
